  "preflight": {
    "when_disabled": [
      "do_not_patch_any_sound_obj_literal",
      "do_not_package_any_of_the_four_mobile_oggs"
    ],
    "when_enabled_require_all": [
      "source_head_and_supported_input_identity_are_explicitly_selected",
      "sound_obj_sha256_matches",
      "fmod_sha256_and_version_match",
      "all_four_record_ids_offsets_relocations_flags_and_preimage_literals_match",
      "each_replacement_literal_is_byte_length_equal_to_its_preimage_literal",
      "all_four_mobile_ogg_sources_exist_and_match_size_sha256_and_oggs_signature",
      "all_four_pc_wav_preimages_exist_and_match_size_sha256_and_riff_wave_signature",
      "all_four_destination_paths_are_unique_and_remain_inside_the_staged_sounds_directory"
    ],
    "failure_action": "abort_before_mutation_or_packaging_and_leave_toggle_disabled"
  },
  "staging_and_rollback": {
    "canonical_sound_obj_mutation_allowed": false,
    "canonical_mobile_obb_asset_mutation_allowed": false,
    "apply_to_staged_build_inputs_only": true,
    "commit_point": "after_all_four_literals_and_all_four_destination_assets_pass_poststage_verification",
    "poststage_require_all": [
      "four_staged_sound_obj_literals_equal_the_replacement_literals",
      "four_staged_destination_files_match_the_pinned_mobile_ogg_hashes",
      "linked_route_pointer_fields_resolve_to_the_expected_ogg_literals_for_the_exact_supported_layout",
      "no_route_uses_oggs_bytes_under_a_wav_filename"
    ],
    "rollback_on_any_failure": [
      "discard_the_entire_staged_toggle_result",
      "publish_no_partial_sound_asset_set",
      "preserve_the_unmodified_pc_wav_routes_and_files"
    ]
  },
  "offline_packaging": {
    "feature_default_enabled": false,
    "must_be_self_contained": true,
    "external_runtime_paths_allowed": false,
    "enabled_package_requirements": [
      "declare_the_optional_toggle_and_contract_id_in_the_package_manifest",
      "include_exactly_the_four_pinned_mobile_oggs_at_the_declared_sounds_destinations",
      "include_the_route_patch_only_when_all_four_assets_are_present_and_verified",
      "record_each_destination_sha256_in_the_offline_manifest",
      "verify_the_final_package_contains_all_four_or_none",
      "keep_the_original_pc_wav_files_available_for_disabled_mode_and_rollback"
    ],
    "disabled_package_requirements": [
