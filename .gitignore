# Generated game packages belong in GitHub Releases, not Git history.
/outputs/
/release-artifacts/
/generated/
/build/
/dist/
/cache/
/.env
/node_modules/
/.venv/

# Python bytecode caches. /work/** already excludes work's, but src/ and
# tests/ are tracked trees, so running the suites leaves __pycache__ dirs
# sitting in `git status` where a `git add -A` can sweep them in.
__pycache__/
*.py[cod]

# Build logs, link maps, and locally generated binary/object trees.
/*.log
/work/*.log
/work/desktop_obj_files/
/work/patched_mobile_furniture_pack_objs/
/work/generated_import_libs/
/work/pydeps/
/work/vf2_apk_extract/
/work/vf3_apk/
/work/b19_overlay/

# `work` is primarily a local reverse-engineering/build cache. Keep only its
# editable source, manifests, tables, and notes under version control.
/work/**
!/work/*.py
!/work/*.ps1
!/work/*.bat
!/work/*.c
!/work/*.cpp
!/work/*.h
!/work/*.hpp
!/work/*.rsp
!/work/*.json
!/work/*.csv
!/work/*.txt
!/work/*.md
!/work/*.idc
!/work/*.js

# Curated, user-supplied Holiday Ornament source PNGs and the reproducible
# canonical runtime layer are project inputs, not extracted bulk assets.
!/work/assets/
!/work/assets/holiday_collectibles/
!/work/assets/holiday_collectibles/*.png
!/work/assets/holiday_collectibles/collection/
!/work/assets/holiday_collectibles/collection/*.png
!/work/assets/mobile_renovations/
!/work/assets/mobile_renovations/*.png
!/work/assets/mobile_renovations/*.md
# VF3 TV sprite strips. Tracked because the alternative -- and what actually
# happened from B164 to B168 -- is that they survive only inside the previous
# release folder and get inherited forward by VF2_PREVIOUS_BUILD_DIR, which
# means nothing notices when the real sources go missing.
!/work/assets/vf3_tv_sprites/
!/work/assets/vf3_tv_sprites/*.png
# Game payloads and compiled artifacts are release assets or local inputs.
*.apk
*.xapk
*.obb
*.pvr
*.zip
*.7z
*.exe
*.dll
*.lib
*.obj
*.pdb
*.map
*.swf
*.xcf

# Tracked source archive used to regenerate holiday villager body frames.
!data/vf2/source_assets/
!data/vf2/source_assets/Holiday Outfits.zip

# Exception: the preserved inherited runtime art. 30 of those 635 files are
# .xcf GIMP originals, and the blanket rule above is why they never entered the
# repository -- they survived only inside previous build outputs. They are the
# source material for regenerating this art, so they must be tracked here.
!patcher_assets/inherited_runtime_images/**

# Preserve editable project source/configuration only from historical folders.
/Unneeded crap/**
!/Unneeded crap/**/*.md
!/Unneeded crap/**/*.txt
!/Unneeded crap/**/*.json
!/Unneeded crap/**/*.csv
!/Unneeded crap/**/*.ps1
!/Unneeded crap/**/*.py
!/Unneeded crap/**/*.c
!/Unneeded crap/**/*.cpp
!/Unneeded crap/**/*.cs
!/Unneeded crap/**/*.h
!/Unneeded crap/**/*.hpp
!/Unneeded crap/**/*.bat
!/Unneeded crap/**/*.rsp

# Never commit local Git/Codex state.
/.git/
/.codex/
/.agents/
